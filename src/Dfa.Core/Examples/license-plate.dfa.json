{
  "format": "dfa-simulator",
  "version": 1,
  "name": "License plate (RoPlate)",
  "alphabet": ["L", "C", "_"],
  "symbolClasses": [
    { "name": "L", "chars": "ABCDEFGHIJKLMNOPQRSTUVWXYZ" },
    { "name": "C", "chars": "0123456789" },
    { "name": "_", "chars": " " }
  ],
  "states": ["q0", "q1", "q2", "B0", "B1", "B2", "B3", "J0", "J1", "J2", "S", "T1", "T2", "T3"],
  "start": "q0",
  "finals": ["T3"],
  "transitions": [
    { "from": "q0", "symbol": "L", "to": "q1" },
    { "from": "q1", "symbol": "L", "to": "q2" },
    { "from": "q1", "symbol": "_", "to": "B0" },
    { "from": "q2", "symbol": "_", "to": "J0" },
    { "from": "B0", "symbol": "C", "to": "B1" },
    { "from": "B1", "symbol": "C", "to": "B2" },
    { "from": "B2", "symbol": "C", "to": "B3" },
    { "from": "B2", "symbol": "_", "to": "S" },
    { "from": "B3", "symbol": "_", "to": "S" },
    { "from": "J0", "symbol": "C", "to": "J1" },
    { "from": "J1", "symbol": "C", "to": "J2" },
    { "from": "J2", "symbol": "_", "to": "S" },
    { "from": "S", "symbol": "L", "to": "T1" },
    { "from": "T1", "symbol": "L", "to": "T2" },
    { "from": "T2", "symbol": "L", "to": "T3" }
  ],
  "layout": {
    "q0": { "x": 100, "y": 250 },
    "q1": { "x": 220, "y": 250 },
    "q2": { "x": 340, "y": 130 },
    "B0": { "x": 340, "y": 370 },
    "B1": { "x": 460, "y": 370 },
    "B2": { "x": 580, "y": 370 },
    "B3": { "x": 700, "y": 450 },
    "J0": { "x": 460, "y": 130 },
    "J1": { "x": 580, "y": 130 },
    "J2": { "x": 700, "y": 130 },
    "S": { "x": 820, "y": 250 },
    "T1": { "x": 940, "y": 250 },
    "T2": { "x": 1060, "y": 250 },
    "T3": { "x": 1180, "y": 250 }
  },
  "descriptions": {
    "q0": "Enter the county code",
    "q1": "Waiting for a second letter, or a space for Bucharest",
    "q2": "Waiting for a space after the county code",
    "B0": "Waiting for 2 or 3 digits",
    "B1": "Waiting for 1 or 2 more digits",
    "B2": "Waiting for a third digit or a space",
    "B3": "Waiting for a space",
    "J0": "Waiting for 2 digits",
    "J1": "Waiting for 1 more digit",
    "J2": "Waiting for a space",
    "S": "Waiting for 3 letters",
    "T1": "Waiting for 2 more letters",
    "T2": "Waiting for 1 more letter",
    "T3": "Valid plate"
  },
  "tests": [
    { "word": "B 12 ABC", "expected": true },
    { "word": "B 123 ABC", "expected": true },
    { "word": "B 001 ZZZ", "expected": true },
    { "word": "CJ 12 ABC", "expected": true },
    { "word": "AB 01 XYZ", "expected": true },
    { "word": "IF 99 AAA", "expected": true },
    { "word": "TM 07 BOB", "expected": true },
    { "word": "VN 10 QWE", "expected": true },
    { "word": "", "expected": false },
    { "word": "CJ 123 ABC", "expected": false },
    { "word": "B 1 ABC", "expected": false },
    { "word": "B 1234 ABC", "expected": false },
    { "word": "CJ12ABC", "expected": false },
    { "word": "CJ 12 AB", "expected": false },
    { "word": "CJ 12 ABCD", "expected": false },
    { "word": "CJ 1A ABC", "expected": false },
    { "word": "ABC 12 XYZ", "expected": false },
    { "word": "cj 12 abc", "expected": false }
  ]
}
