<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Dfa.App.Views.Simulator"
             x:Class="Dfa.App.Views.Simulator.ExecutionTable"
             x:DataType="vm:SimulatorViewModel"
             x:CompileBindings="True">

    <UserControl.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Margin" Value="{DynamicResource Padding.Cell}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Small}" />
        </Style>
        <Style Selector="Border.bar">
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="{DynamicResource Thickness.CurrentBar}" />
        </Style>
        <!-- The current row: bold text, a soft fill and an accent bar on the left, so not by color alone. -->
        <Style Selector="Border.current">
            <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
        </Style>
        <Style Selector="Border.current > Border.bar">
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.StateCurrent}" />
        </Style>
        <Style Selector="Border.current TextBlock">
            <Setter Property="FontWeight" Value="{DynamicResource Weight.Bold}" />
        </Style>
    </UserControl.Styles>

    <!-- S-03: Step, Read, (Class, if different), Remaining, State; row 0 = the initial configuration. -->
    <StackPanel Grid.IsSharedSizeScope="True">
        <Border Classes="table-header">
            <Border Classes="bar">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition SharedSizeGroup="Step" />
                        <ColumnDefinition SharedSizeGroup="Read" />
                        <ColumnDefinition SharedSizeGroup="Class" />
                        <ColumnDefinition SharedSizeGroup="Remaining" />
                        <ColumnDefinition SharedSizeGroup="State" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Classes="th" Text="Step" />
                    <TextBlock Grid.Column="1" Classes="th" Text="Read" />
                    <TextBlock Grid.Column="2" Classes="th" Text="Class" IsVisible="{Binding ShowClassColumn}" />
                    <TextBlock Grid.Column="3" Classes="th" Text="Remaining" />
                    <TextBlock Grid.Column="4" Classes="th" Text="State" />
                </Grid>
            </Border>
        </Border>

        <ItemsControl ItemsSource="{Binding ExecutionRows}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ExecutionRow">
                    <Border Classes="table-row" Classes.current="{Binding IsCurrent}">
                        <Border Classes="bar">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition SharedSizeGroup="Step" />
                                    <ColumnDefinition SharedSizeGroup="Read" />
                                    <ColumnDefinition SharedSizeGroup="Class" />
                                    <ColumnDefinition SharedSizeGroup="Remaining" />
                                    <ColumnDefinition SharedSizeGroup="State" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Step}" />
                                <TextBlock Grid.Column="1" Classes="mono" Text="{Binding Read}" />
                                <TextBlock Grid.Column="2" Text="{Binding Class}"
                                           IsVisible="{Binding $parent[UserControl].((vm:SimulatorViewModel)DataContext).ShowClassColumn}" />
                                <TextBlock Grid.Column="3" Classes="mono" Text="{Binding Remaining}" />
                                <TextBlock Grid.Column="4" Text="{Binding State}" />
                            </Grid>
                        </Border>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
