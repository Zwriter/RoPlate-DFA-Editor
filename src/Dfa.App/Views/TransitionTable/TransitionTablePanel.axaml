<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Dfa.App.Views.TransitionTable"
             x:Class="Dfa.App.Views.TransitionTable.TransitionTablePanel"
             x:DataType="vm:TransitionTableViewModel"
             x:CompileBindings="True">

    <UserControl.Styles>
        <Style Selector="Border.cell">
            <Setter Property="Width" Value="{DynamicResource Size.DeltaCell}" />
            <Setter Property="Padding" Value="{DynamicResource Padding.Cell}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="{DynamicResource Thickness.CellLines}" />
        </Style>
        <!-- An editable cell looks like a read-only one: the ghost button fills it without its own padding. -->
        <Style Selector="Button.cell-button">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.cell > TextBlock, Button.cell-button > TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Small}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.header">
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
        </Style>
        <Style Selector="Border.header > TextBlock">
            <Setter Property="FontWeight" Value="{DynamicResource Weight.SemiBold}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
        </Style>
        <!-- Missing cells also show "—", so the gap is not conveyed by color alone. -->
        <Style Selector="Border.missing">
            <Setter Property="Background" Value="{DynamicResource Brush.MissingCell}" />
        </Style>
    </UserControl.Styles>

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="{DynamicResource Margin.RowGap}">
            <TextBlock Classes="heading" Text="Transition table δ" />
            <TextBlock Classes="muted small" Text="→ start · * final · — missing · click a cell to change it" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom" Classes="field-error" Text="{Binding Error, StringFormat='✗ {0}'}"
                   IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Classes="cell header">
                        <TextBlock Text="δ" />
                    </Border>
                    <ItemsControl ItemsSource="{Binding Symbols}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border Classes="cell header">
                                    <TextBlock Text="{Binding}" ToolTip.Tip="{Binding}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TransitionRow">
                            <StackPanel Orientation="Horizontal">
                                <Border Classes="cell header">
                                    <TextBlock Text="{Binding Label}" ToolTip.Tip="{Binding Label}" />
                                </Border>
                                <ItemsControl ItemsSource="{Binding Cells}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <!-- ED-11: click (or Enter) opens a menu of targets; the current one is checked. -->
                                        <DataTemplate x:DataType="vm:TransitionCell">
                                            <Border Classes="cell"
                                                    Classes.missing="{Binding Target, Converter={x:Static ObjectConverters.IsNull}}">
                                                <Button Classes="ghost cell-button"
                                                        ToolTip.Tip="{Binding Name, StringFormat='{}{0}: click to change'}"
                                                        AutomationProperties.Name="{Binding Name}">
                                                    <TextBlock Text="{Binding Target, TargetNullValue=—}" />
                                                    <Button.Flyout>
                                                        <MenuFlyout ItemsSource="{Binding Choices}">
                                                            <MenuFlyout.ItemContainerTheme>
                                                                <ControlTheme TargetType="MenuItem" x:DataType="vm:TransitionChoice"
                                                                              BasedOn="{StaticResource {x:Type MenuItem}}">
                                                                    <Setter Property="Header" Value="{Binding Label}" />
                                                                    <Setter Property="Command" Value="{Binding Pick}" />
                                                                    <Setter Property="ToggleType" Value="Radio" />
                                                                    <Setter Property="IsChecked" Value="{Binding IsCurrent, Mode=OneWay}" />
                                                                </ControlTheme>
                                                            </MenuFlyout.ItemContainerTheme>
                                                        </MenuFlyout>
                                                    </Button.Flyout>
                                                </Button>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
