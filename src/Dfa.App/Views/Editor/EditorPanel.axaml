<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Dfa.App.Views.Editor"
             xmlns:model="using:Dfa.Core.Model"
             x:Class="Dfa.App.Views.Editor.EditorPanel"
             x:DataType="vm:EditorViewModel"
             x:CompileBindings="True">

    <!-- E-04: the Σ list and the symbol classes; OpResult errors below the field (✗ + red border, not color alone). -->
    <StackPanel Spacing="{DynamicResource Gap.Related}">
        <TextBlock Classes="heading" Text="Alphabet (Σ)" />
        <ItemsControl ItemsSource="{Binding Symbols}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <Border Classes="chip">
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Gap.Inline}">
                            <TextBlock Classes="mono" Text="{Binding}" VerticalAlignment="Center" />
                            <Button Classes="ghost chip-remove" Content="×" ToolTip.Tip="Remove"
                                    AutomationProperties.Name="{Binding StringFormat='Remove symbol {0}'}"
                                    Command="{Binding $parent[UserControl].((vm:EditorViewModel)DataContext).RemoveSymbolCommand}"
                                    CommandParameter="{Binding}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Gap.Related}">
            <TextBox Classes="mono" Text="{Binding NewSymbol}" PlaceholderText="e.g. a" MaxLength="1"
                     AutomationProperties.Name="New symbol"
                     Classes.error="{Binding SymbolError, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding AddSymbolCommand}" />
                </TextBox.KeyBindings>
            </TextBox>
            <Button Grid.Column="1" Content="Add" Command="{Binding AddSymbolCommand}" />
        </Grid>
        <TextBlock Classes="field-error" Text="{Binding SymbolError, StringFormat='✗ {0}'}"
                   IsVisible="{Binding SymbolError, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <TextBlock Classes="heading" Text="Symbol classes" Margin="{DynamicResource Margin.SectionTop}" />
        <ItemsControl ItemsSource="{Binding Classes}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="model:SymbolClass">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource Gap.Group}"
                          Margin="{DynamicResource Margin.RowGap}">
                        <TextBlock Classes="strong" Text="{Binding Name}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Classes="mono muted" Text="{Binding Characters}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Characters}" />
                        <Button Grid.Column="2" Classes="ghost chip-remove" Content="×" ToolTip.Tip="Remove"
                                AutomationProperties.Name="{Binding Name, StringFormat='Remove class {0}'}"
                                Command="{Binding $parent[UserControl].((vm:EditorViewModel)DataContext).RemoveClassCommand}"
                                CommandParameter="{Binding}" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Grid ColumnDefinitions="80,*,Auto" ColumnSpacing="{DynamicResource Gap.Related}">
            <TextBox Text="{Binding NewClassName}" PlaceholderText="Name" AutomationProperties.Name="Class name"
                     Classes.error="{Binding ClassError, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <!-- Help for ranges: "A-Z" ⇒ SymbolClass.FromRanges. -->
            <TextBox Grid.Column="1" Classes="mono" Text="{Binding NewClassCharacters}"
                     PlaceholderText="Characters, e.g. A-Z or 0-9" AutomationProperties.Name="Class characters"
                     Classes.error="{Binding ClassError, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding AddClassCommand}" />
                </TextBox.KeyBindings>
            </TextBox>
            <Button Grid.Column="2" Content="Add" Command="{Binding AddClassCommand}" />
        </Grid>
        <TextBlock Classes="field-error" Text="{Binding ClassError, StringFormat='✗ {0}'}"
                   IsVisible="{Binding ClassError, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>
</UserControl>
