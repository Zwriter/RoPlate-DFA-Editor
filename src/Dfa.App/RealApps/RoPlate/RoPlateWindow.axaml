<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Dfa.App.RealApps.RoPlate"
        xmlns:controls="using:Dfa.App.Controls"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        x:Class="Dfa.App.RealApps.RoPlate.RoPlateWindow"
        x:DataType="vm:RoPlateViewModel"
        x:CompileBindings="True"
        Title="RoPlate"
        Width="520" SizeToContent="Height" CanResize="False"
        ExtendClientAreaToDecorationsHint="True" WindowDecorations="BorderOnly"
        Background="{DynamicResource Brush.Surface}">

    <Window.Styles>
        <Style Selector="TextBox.plate">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Plate}" />
            <Setter Property="FontWeight" Value="{DynamicResource Weight.SemiBold}" />
        </Style>
        <!-- Red (blocked) and green (valid): a thick colored outline plus ✗ / ✓, so not by color alone.
             Set on the template border so it also holds while the field has focus. -->
        <Style Selector="TextBox.blocked /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Rejected}" />
            <Setter Property="BorderThickness" Value="{DynamicResource Thickness.LastEdge}" />
        </Style>
        <Style Selector="TextBox.valid /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accepted}" />
            <Setter Property="BorderThickness" Value="{DynamicResource Thickness.LastEdge}" />
        </Style>
    </Window.Styles>

    <DockPanel>
        <!-- App-drawn title bar, like the main window: drag area + close / minimize (no maximize: fixed size). -->
        <Border DockPanel.Dock="Top" Classes="menubar">
            <DockPanel>
                <controls:CaptionButtons DockPanel.Dock="Right" CanMaximize="False" />
                <Border chrome:WindowDecorationProperties.ElementRole="TitleBar" Background="Transparent" />
            </DockPanel>
        </Border>
        <StackPanel Margin="{DynamicResource Padding.Window}" Spacing="{DynamicResource Gap.Section}">
            <TextBox Classes="plate" Text="{Binding Text}" AutomationProperties.Name="License plate"
                     Classes.blocked="{Binding IsBlocked}" Classes.valid="{Binding IsValid}" />

            <controls:VerdictLine Text="{Binding Message}" IsAccepted="{Binding IsValid}" IsRejected="{Binding IsBlocked}" />

            <Button Content="Show automaton" Command="{Binding ShowAutomatonCommand}" />
        </StackPanel>
    </DockPanel>
</Window>
