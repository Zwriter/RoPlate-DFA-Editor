<!--
  The shared colors from contract 3, section 5, for the light and the dark theme.
  The key names are fixed by the contract; their values alias the design tokens (DESIGN_RULES.md §2):
  StateCurrent / EdgeLast / TapeCursor = Accent, Accepted = Success, Rejected = Danger,
  MissingCell = MissingFill, TapeRead = TextMuted.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="avares://Dfa.App/Themes/Tokens.axaml" />
  </ResourceDictionary.MergedDictionaries>

  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="Brush.StateCurrent" Color="{StaticResource Color.Umber.600}" />
      <SolidColorBrush x:Key="Brush.Accepted" Color="{StaticResource Color.Olive.600}" />
      <SolidColorBrush x:Key="Brush.Rejected" Color="{StaticResource Color.Oxblood.600}" />
      <SolidColorBrush x:Key="Brush.EdgeLast" Color="{StaticResource Color.Umber.600}" />
      <SolidColorBrush x:Key="Brush.MissingCell" Color="{StaticResource Color.Rose.100}" />
      <SolidColorBrush x:Key="Brush.TapeRead" Color="{StaticResource Color.Paper.800}" />
      <SolidColorBrush x:Key="Brush.TapeCursor" Color="{StaticResource Color.Umber.600}" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="Brush.StateCurrent" Color="{StaticResource Color.Caramel.300}" />
      <SolidColorBrush x:Key="Brush.Accepted" Color="{StaticResource Color.Olive.300}" />
      <SolidColorBrush x:Key="Brush.Rejected" Color="{StaticResource Color.Oxblood.300}" />
      <SolidColorBrush x:Key="Brush.EdgeLast" Color="{StaticResource Color.Caramel.300}" />
      <SolidColorBrush x:Key="Brush.MissingCell" Color="{StaticResource Color.Wine.900}" />
      <SolidColorBrush x:Key="Brush.TapeRead" Color="{StaticResource Color.Cream.400}" />
      <SolidColorBrush x:Key="Brush.TapeCursor" Color="{StaticResource Color.Caramel.300}" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
