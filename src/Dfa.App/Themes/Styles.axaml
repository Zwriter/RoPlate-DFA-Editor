<!-- The shared colors from contract 3, section 5, for the light and the dark theme. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="Brush.StateCurrent" Color="#0063B1" />
            <SolidColorBrush x:Key="Brush.Accepted" Color="#107C10" />
            <SolidColorBrush x:Key="Brush.Rejected" Color="#C42B1C" />
            <SolidColorBrush x:Key="Brush.EdgeLast" Color="#0063B1" />
            <SolidColorBrush x:Key="Brush.MissingCell" Color="#FDE7E9" />
            <SolidColorBrush x:Key="Brush.TapeRead" Color="#8A8A8A" />
            <SolidColorBrush x:Key="Brush.TapeCursor" Color="#0063B1" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="Brush.StateCurrent" Color="#60CDFF" />
            <SolidColorBrush x:Key="Brush.Accepted" Color="#6CCB5F" />
            <SolidColorBrush x:Key="Brush.Rejected" Color="#FF99A4" />
            <SolidColorBrush x:Key="Brush.EdgeLast" Color="#60CDFF" />
            <SolidColorBrush x:Key="Brush.MissingCell" Color="#442726" />
            <SolidColorBrush x:Key="Brush.TapeRead" Color="#808080" />
            <SolidColorBrush x:Key="Brush.TapeCursor" Color="#60CDFF" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
