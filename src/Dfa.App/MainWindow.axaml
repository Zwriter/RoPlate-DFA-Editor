<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:Dfa.App"
        xmlns:controls="using:Dfa.App.Controls"
        xmlns:editor="using:Dfa.App.Views.Editor"
        xmlns:examples="using:Dfa.Core.Examples"
        xmlns:simulator="using:Dfa.App.Views.Simulator"
        xmlns:i="using:Avalonia.Xaml.Interactivity"
        xmlns:ia="using:Avalonia.Xaml.Interactions.Core"
        xmlns:table="using:Dfa.App.Views.TransitionTable"
        x:Class="Dfa.App.MainWindow"
        x:DataType="app:MainViewModel"
        x:CompileBindings="True"
        Title="{Binding Title}"
        Width="1100" Height="700" MinWidth="800" MinHeight="500">

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+N" Command="{Binding NewCommand}" />
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenCommand}" />
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" />
    <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
    <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
  </Window.KeyBindings>

  <Window.Styles>
    <Style Selector="TextBlock.wip">
      <Setter Property="Text" Value="Work in progress" />
      <Setter Property="Margin" Value="8" />
      <Setter Property="FontStyle" Value="Italic" />
    </Style>
  </Window.Styles>

  <DockPanel>
    <!-- The menu row from contract 3: File, Examples, Edit, [↶] [↷] [Complete with trap state]. -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="4">
      <Menu>
        <MenuItem Header="_File">
          <MenuItem Header="_New" InputGesture="Ctrl+N" Command="{Binding NewCommand}" />
          <MenuItem Header="_Open…" InputGesture="Ctrl+O" Command="{Binding OpenCommand}" />
          <MenuItem Header="_Save" InputGesture="Ctrl+S" Command="{Binding SaveCommand}" />
          <MenuItem Header="Save _as…" InputGesture="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" />
          <MenuItem Header="_Export as PNG…" Command="{Binding ExportPngCommand}" />
        </MenuItem>
        <MenuItem Header="_Examples" ItemsSource="{Binding Examples}">
          <MenuItem.Styles>
            <Style Selector="MenuItem > MenuItem" x:DataType="examples:ExampleInfo">
              <Setter Property="Header" Value="{Binding Title}" />
              <Setter Property="Command"
                      Value="{Binding $parent[Window].((app:MainViewModel)DataContext).OpenExampleCommand}" />
              <Setter Property="CommandParameter" Value="{Binding}" />
            </Style>
          </MenuItem.Styles>
        </MenuItem>
        <MenuItem Header="E_dit">
          <MenuItem Header="_Undo" InputGesture="Ctrl+Z" Command="{Binding UndoCommand}" />
          <MenuItem Header="_Redo" InputGesture="Ctrl+Y" Command="{Binding RedoCommand}" />
          <MenuItem Header="Complete with _trap state" Command="{Binding CompleteWithTrapCommand}" />
        </MenuItem>
        <MenuItem Header="_Apps">
          <MenuItem Header="_RoPlate" Command="{Binding ShowRoPlateCommand}" />
        </MenuItem>
      </Menu>
      <!-- E-06: the toolbar buttons; ↶ / ↷ have a name and a tooltip, not only the symbol. -->
      <Button Content="↶" Command="{Binding UndoCommand}" VerticalAlignment="Center"
              ToolTip.Tip="Undo (Ctrl+Z)" AutomationProperties.Name="Undo" />
      <Button Content="↷" Command="{Binding RedoCommand}" VerticalAlignment="Center"
              ToolTip.Tip="Redo (Ctrl+Y)" AutomationProperties.Name="Redo" />
      <Button Content="Complete with trap state" Command="{Binding CompleteWithTrapCommand}" VerticalAlignment="Center" />
    </StackPanel>

    <Border DockPanel.Dock="Bottom" Padding="8,4"
            BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <TextBlock Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" />
    </Border>

    <Grid ColumnDefinitions="*,4,380">
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <!-- S-06: the simulation is shown on the drawing (contract 3, section 6). -->
        <controls:DfaCanvas Document="{Binding Session.Document}"
                            Mode="{Binding CurrentCanvasMode}"
                            HighlightedState="{Binding Simulator.CurrentState}"
                            HighlightKind="{Binding Simulator.HighlightKind}"
                            HighlightedEdge="{Binding Simulator.LastEdge}">
          <!-- Editing errors (e.g. the ED-04 message) go to the status bar. -->
          <i:Interaction.Behaviors>
            <ia:EventTriggerBehavior EventName="StatusMessage">
              <ia:InvokeCommandAction Command="{Binding ShowStatusCommand}" />
            </ia:EventTriggerBehavior>
            <ia:EventTriggerBehavior EventName="StateClicked">
              <ia:InvokeCommandAction Command="{Binding StateClickedCommand}" />
            </ia:EventTriggerBehavior>
          </i:Interaction.Behaviors>
        </controls:DfaCanvas>
      </ScrollViewer>
      <GridSplitter Grid.Column="1" ResizeDirection="Columns" />
      <TabControl Grid.Column="2" SelectedIndex="{Binding SelectedTabIndex}">
        <!-- Order matches MainTab: Editor, Simulator, Tests. -->
        <TabItem Header="Edit">
          <!-- E-04: the alphabet and the classes, with the δ table (P1) below. -->
          <DockPanel Margin="8">
            <editor:EditorPanel DockPanel.Dock="Top" DataContext="{Binding Editor}" Margin="0,0,0,12" />
            <table:TransitionTablePanel DataContext="{Binding Table}" />
          </DockPanel>
        </TabItem>
        <TabItem Header="Simulate">
          <simulator:SimulatorPanel DataContext="{Binding Simulator}" />
        </TabItem>
        <TabItem Header="Tests">
          <simulator:BatchTestPanel DataContext="{Binding BatchTests}" />
        </TabItem>
      </TabControl>
    </Grid>
  </DockPanel>
</Window>
