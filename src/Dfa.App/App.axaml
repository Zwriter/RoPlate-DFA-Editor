<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Dfa.App.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- The contract 3 brushes; it merges the design tokens (Themes/Tokens.axaml). -->
                <ResourceInclude Source="avares://Dfa.App/Themes/Styles.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <!-- The "Notebook · Old Paper" control styles (DESIGN_RULES.md), after Fluent so they win. -->
        <StyleInclude Source="avares://Dfa.App/Themes/Controls.axaml" />
    </Application.Styles>
</Application>
